diff --git a/cmake/linker/linker_script_common.cmake b/cmake/linker/linker_script_common.cmake
--- a/cmake/linker/linker_script_common.cmake
+++ b/cmake/linker/linker_script_common.cmake
@@ -238,6 +238,13 @@ function(add_region)
 
   set_property(GLOBAL PROPERTY ${ADD_REGION_REGION}_PARENT ${ADD_REGION_OBJECT})
   set_property(GLOBAL APPEND PROPERTY ${ADD_REGION_OBJECT}_REGIONS ${ADD_REGION_REGION})
+
+  # Build lookup: <system>_REGION_BY_NAME_<NAME> -> <region object>.
+  # The armlink generator uses this to place global symbols in FLASH.
+  get_property(_r_name GLOBAL PROPERTY ${ADD_REGION_REGION}_NAME)
+  if(_r_name STREQUAL "FLASH")
+    set_property(GLOBAL PROPERTY ${ADD_REGION_OBJECT}_REGION_BY_NAME_${_r_name} ${ADD_REGION_REGION})
+  endif()
 endfunction()
 
 function(add_group)
diff --git a/cmake/linker/armlink/scatter_script.cmake b/cmake/linker/armlink/scatter_script.cmake
--- a/cmake/linker/armlink/scatter_script.cmake
+++ b/cmake/linker/armlink/scatter_script.cmake
@@ -17,6 +17,7 @@ function(process_region)
     get_parent(OBJECT ${REGION_OBJECT} PARENT parent TYPE SYSTEM)
     get_property(symbols GLOBAL PROPERTY ${parent}_SYMBOLS)
-    set_property(GLOBAL APPEND PROPERTY ${REGION_OBJECT}_SYMBOLS ${symbols})
+    get_property(flash GLOBAL PROPERTY ${parent}_REGION_BY_NAME_FLASH)
+    set_property(GLOBAL APPEND PROPERTY ${flash}_SYMBOLS ${symbols})
     set_property(GLOBAL PROPERTY ${parent}_SYMBOLS)
   endif()
 
